#!/command/with-contenv sh
# stationd, cwd = $STATIOND_ROOT (chemins relatifs de stationd.toml) :
#   dev          → utilisateur `dev`, racine du dépôt monté (/src)
#   exploitation → utilisateur `stationd`, /var/lib/stationd (= /srv/stationd de l'hôte)
# Prêt = répond en gRPC (data/check) : à ce stade station.liq et icecast.xml
# sont écrits (main.rs les écrit avant d'ouvrir le port) → Icecast et
# Liquidsoap peuvent démarrer.
bin="$STATIOND_BIN/stationd"
if [ ! -x "$bin" ]; then
  echo "[stationd] $bin absent (dev : lancer cargo build dans le conteneur, README)" >&2
  sleep 5
  exit 1
fi
if [ ! -f "$STATIOND_ROOT/stationd.toml" ]; then
  echo "[stationd] $STATIOND_ROOT/stationd.toml absent (modèle : stationd.example.toml)" >&2
  sleep 5
  exit 1
fi
exec s6-notifyoncheck -d -n 0 -s 500 -w 1000 -t 3000 \
  s6-setuidgid "${STATIOND_USER:-dev}" \
  sh -c 'cd "$STATIOND_ROOT" && exec "$STATIOND_BIN/stationd" --config stationd.toml'
