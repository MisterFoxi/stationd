#!/command/with-contenv sh
# stationd, cwd = $STATIOND_ROOT (chemins relatifs de stationd.toml) :
#   dev          → utilisateur `dev`, racine du dépôt monté (/src)
#   exploitation → utilisateur `stationd`, /var/lib/stationd (= répertoire d'installation de l'hôte)
# Prêt = répond en gRPC (data/check) : à ce stade station.liq et icecast.xml
# sont écrits (main.rs les écrit avant d'ouvrir le port) → Icecast et
# Liquidsoap peuvent démarrer.
bin="$STATIOND_BIN/stationd"
if [ ! -x "$bin" ]; then
  echo "[stationd] $bin absent (dev : lancer cargo build dans le conteneur, README)" >&2
  sleep 5
  exit 1
fi
if [ ! -f "$STATIOND_ROOT/stationd.toml" ]; then
  echo "[stationd] $STATIOND_ROOT/stationd.toml absent (modèle : stationd.example.toml)" >&2
  sleep 5
  exit 1
fi
# `stationctl station start` (utilisateur dev / stationd, pas root) doit
# pouvoir relancer ce service et attendre qu'il soit prêt : lecture de l'état,
# contrôle et abonnement aux événements ouverts au groupe stationd. Posé à
# chaque lancement (le répertoire de supervision vit dans /run).
if ! s6-svperms -g stationd -O stationd -E stationd . ; then
  echo "[stationd] s6-svperms a échoué : seul root pourra lancer « stationctl station start »" >&2
fi
# Arrêt opérateur (`stationctl station stop`, src/operator_stop.rs) : le
# marqueur data/stationd.stopped est présent → on ne lance PAS stationd. Le
# service se déclare prêt (Liquidsoap et Icecast, qui en dépendent, démarrent
# quand même, sur le .liq et l'icecast.xml du dernier lancement) puis dort.
# Relance : `stationctl station start` (retire le marqueur + s6-svc -r).
if [ -f "$STATIOND_ROOT/data/stationd.stopped" ]; then
  echo "[stationd] arrêté par l'opérateur ($STATIOND_ROOT/data/stationd.stopped) — relance : stationctl station start" >&2
  echo >&3        # notification-fd = 3 : prêt
  exec s6-pause   # parqué : s6 supervise, ne relance rien
fi
# Exploitation : umask 007 (STATIOND_UMASK) — ce que stationd écrit
# (playlist add…) reste modifiable par le groupe stationd, donc par
# l'administrateur du nœud. Dev : 022 (défaut), rien ne change.
umask "${STATIOND_UMASK:-022}"
exec s6-notifyoncheck -d -n 0 -s 500 -w 1000 -t 3000 \
  s6-setuidgid "${STATIOND_USER:-dev}" \
  sh -c 'cd "$STATIOND_ROOT" && exec "$STATIOND_BIN/stationd" --config stationd.toml'
