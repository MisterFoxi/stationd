{
  "authority": "stationdeck-dev",
  "discovery_address": "255.255.255.255:50072",
  "trust": [
    {
      "instance": "icecast-admin-1",
      "key_file": "/run/secrets/icecast-admin-discovery-key"
    }
  ],
  "bindings": [
    {
      "interface": "stationdeck.icecast.streams",
      "version": "^1.0.0",
      "transport": "grpc",
      "instance": "icecast-admin-1",
      "allow_plaintext": true
    }
  ]
}
